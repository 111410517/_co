// File name: projects/05/Memory.hdl

/**
 * The complete address space of the Hack computer's memory:
 * RAM at 0x0000-0x3FFF, screen memory at 0x4000-0x5FFF,
 * and the keyboard map at 0x6000.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Decode the two memory-mapped I/O regions.
    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=screenAddress);
    And(a=address[14], b=address[13], out=keyboardAddress);
    Not(in=address[14], out=ramAddress);

    And(a=load, b=ramAddress, out=loadRAM);
    And(a=load, b=screenAddress, out=loadScreen);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    // Choose RAM, screen, or keyboard according to the address region.
    Mux16(a=ramOut, b=screenOut, sel=screenAddress, out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyboardOut, sel=keyboardAddress, out=out);
}